# Files and generated artifacts that should stay out of version control.
# Includes local secrets, environments, caches, and user-uploaded resume data.
# Environment variables & secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.pytest_cache/
.venv/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs & scratch debug dumps
*.log
*_out.txt
debug*.py
inspect_jobs.py
math_check.py
backfill_skills.py
test_chat.py
test_rec.py

# Generated runtime artifacts
backend/generated_resumes/
resume-pipeline.jpeg
file

# OS
.DS_Store
Thumbs.db
# Uploaded original resumes (personal data)
backend/uploaded_resumes/
.neon

# Database backups (contain personal data)
backups/
# Machine-specific extra root certificates for Docker builds
docker/certs/*.crt
docker/certs/*.pem
# Generated database seed for the cafy-agent-db image (docker/postgres/build-seed.ps1)
docker/postgres/initdb/
# Full database seed with personal data (build-seed.ps1 -Full) - never commit
docker/postgres/initdb-full/
