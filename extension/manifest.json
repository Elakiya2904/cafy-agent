{
  "manifest_version": 3,
  "name": "Cafy Application Assistant",
  "version": "1.0.0",
  "description": "Autofills job applications from your Cafy profile. You review and approve before anything is submitted.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.workable.com/*",
    "https://*.oraclecloud.com/*",
    "https://*.breezy.hr/*",
    "https://*.pinpointhq.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://*.greenhouse.io/*", "https://*.lever.co/*", "https://*.ashbyhq.com/*", "https://*.myworkdayjobs.com/*",
        "https://*.workable.com/*", "https://*.oraclecloud.com/*", "https://*.breezy.hr/*", "https://*.pinpointhq.com/*"
      ],
      "js": ["content.js"],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ],
  "action": { "default_title": "Cafy: use on this page (generic forms)" },
  "options_page": "options.html"
}
