((# ATS-friendly, single-column A4 resume in the UK template layout:
   centred bold name, role and "phone | email | location" line; a full-width rule before every
   section; five sections (About Me, Education, Work Experience, Projects, Skills); each entry
   is "Organisation, Location | dates" then the role/degree in bold; skills in three columns.
   Sections, order and entry lines come from resume_structure.render_sections, the same model
   the DOCX export and the in-app preview use. A long resume continues onto a second page. #))
\documentclass[11pt,a4paper]{article}
\usepackage[a4paper,margin=1.7cm]{geometry}
\usepackage[T1]{fontenc}
\usepackage[utf8]{inputenc}
\usepackage[scaled=0.95]{helvet}
\renewcommand{\familydefault}{\sfdefault}
\usepackage{enumitem}
\usepackage{multicol}
\usepackage[hidelinks]{hyperref}
\usepackage{titlesec}
\pagestyle{empty}
\raggedbottom
\setlength{\parindent}{0pt}
\setlength{\parskip}{0pt}
\linespread{1.08}
\setlist[itemize]{leftmargin=1.2em, itemsep=1pt, topsep=2pt, parsep=0pt}
% Rule above each heading; \section* keeps its title on the same page as what follows it.
\titleformat{\section}{\Large\bfseries\uppercase}{}{0pt}{}
\titlespacing*{\section}{0pt}{4pt}{4pt}
\newcommand{\sectionrule}{\par\vspace{8pt}\noindent\rule{\linewidth}{0.8pt}\par}
\begin{document}
\begin{center}
((*- if personal_info.name *))
  {\fontsize{26}{30}\selectfont\bfseries (( personal_info.name | upper | texescape ))}\\[4pt]
((*- endif *))
((*- if target_role *))
  {\Large (( target_role | texescape ))}\\[6pt]
((*- endif *))
((*- if contacts *))
  {\normalsize
  ((*- for item in contacts *))
  ((*- if not loop.first *)) \quad\textbar\quad ((* endif -*))
  ((*- if item.href *))\href{(( item.href | urlescape ))}{(( item.text | texescape ))}((*- else *))(( item.text | texescape ))((*- endif *))
  ((*- endfor *))}
((*- endif *))
\end{center}
((* for section in sections *))
\sectionrule
\section*{(( section.title | texescape ))}
((*- if section.kind == "text" *))
(( section.text | texescape ))\par
((*- elif section.kind == "skills" *))
\begin{multicols}{3}
\begin{itemize}
((*- for skill in section.skills *))
  \item (( skill | texescape ))
((*- endfor *))
\end{itemize}
\end{multicols}
((*- else *))
((*- for entry in section.entries *))
((* if not loop.first *))\vspace{7pt}((* endif *))
((*- if entry.meta *))
\noindent (( entry.meta | texescape ))\par\nopagebreak
((*- endif *))
((*- if entry.heading *))
\noindent\textbf{(( entry.heading | texescape ))}\par\nopagebreak
((*- endif *))
((*- if entry.description *))
(( entry.description | texescape ))\par
((*- endif *))
((*- if entry.bullets *))
\begin{itemize}
((*- for bullet in entry.bullets *))
  \item (( bullet | texescape ))
((*- endfor *))
\end{itemize}
((*- endif *))
((*- endfor *))
((*- endif *))
((*- endfor *))

\end{document}
