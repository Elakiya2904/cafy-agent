# Template of supported environment variables; replace placeholders in a private .env file.
# Lists local database, auth, integrations, and application behavior settings.
# Local development database
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/cafy_agent
DB_POOL_MAX=10

# Authentication. JWT_SECRET_KEY signs user sessions and is REQUIRED in production (32+ characters):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left empty in development, a temporary key is used and sessions end when the server restarts.
JWT_SECRET_KEY=
JWT_ISSUER=cafy-agent
JWT_AUDIENCE=cafy-agent-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Existing integrations
GROQ_API_KEY=
NANGO_SECRET_KEY=
NANGO_API_BASE=https://api.nango.dev
EMAIL_AGENT_SECRET=
TOKEN_ENCRYPTION_KEY=

# Application
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:5173
# Guest login ("Continue as Guest"). On by default in development; in production only when set to true,
# and then every guest gets a private, temporary account.
ENABLE_GUEST_MODE=true

# Background scraper schedule (UK time, including daylight-saving changes)
SCRAPE_HOUR=8
SCRAPE_MINUTE=0
SCRAPE_TIMEZONE=Europe/London

# Frontend guest-mode setting
VITE_ENABLE_GUEST_MODE=true

# ---------------------------------------------------------------- Docker (docker compose up -d)
# The API container ignores DATABASE_URL above and connects to the "db" container with these credentials.
# Use letters and digits only for the password (it is placed inside a connection URL):
#   python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_DB=cafy_agent
POSTGRES_USER=cafy
POSTGRES_PASSWORD=
# Host ports: PostgreSQL is published on 127.0.0.1 only; 5433 avoids clashing with a local server on 5432.
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000
# 127.0.0.1 = API reachable from this machine only; 0.0.0.0 = from your network too
API_BIND=127.0.0.1
# APP_ENV inside the container (defaults to APP_ENV above). Use production on a public server.
DOCKER_APP_ENV=
# Image name used by docker compose build/push, e.g. yourdockerhubuser/cafy-agent-backend:1.0.0
BACKEND_IMAGE=cafy-agent-backend:local
# Database image. postgres:18 starts empty; yourdockerhubuser/cafy-agent-db:1.0.0 starts with the schema and the
# job listings (no personal data). Only used when the pgdata volume is new/empty.
DB_IMAGE=postgres:18
# true = install LaTeX in the image so the server can compile resume PDFs (adds several hundred MB)
INSTALL_LATEX=false
