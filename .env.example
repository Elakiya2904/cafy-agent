# Template of supported environment variables; replace placeholders in a private .env file.
# Lists local database, auth, integrations, and application behavior settings.
# Local development database
DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/cafy_agent
DB_POOL_MAX=10

# Authentication. JWT_SECRET_KEY signs user sessions and is REQUIRED in production (32+ characters):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Left empty in development, a temporary key is used and sessions end when the server restarts.
JWT_SECRET_KEY=
JWT_ISSUER=cafy-agent
JWT_AUDIENCE=cafy-agent-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Existing integrations
GROQ_API_KEY=
NANGO_SECRET_KEY=
NANGO_API_BASE=https://api.nango.dev
EMAIL_AGENT_SECRET=
TOKEN_ENCRYPTION_KEY=

# Application
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:5173
# Guest login ("Continue as Guest", for testing only). On by default in development, never in production.
ENABLE_GUEST_MODE=true

# Background scraper schedule (UK time, including daylight-saving changes)
SCRAPE_HOUR=8
SCRAPE_MINUTE=0
SCRAPE_TIMEZONE=Europe/London

# Frontend guest-mode setting
VITE_ENABLE_GUEST_MODE=true
